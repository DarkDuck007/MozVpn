<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.duckyvpn.mozvpn</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="12.1.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <ProjectReference Include="..\Moz_Avalonia\Moz_Avalonia.csproj" />
    <ProjectReference Include="..\MozUtil\MozUtil.csproj" />
    <ProjectReference Include="..\Moz_Avalonia.Android.Bindings\Moz_Avalonia.Android.Bindings.csproj" />
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>release.keystore</AndroidSigningKeyStore>
    <AndroidSigningStorePass>duckyvpn2026</AndroidSigningStorePass>
    <AndroidSigningKeyAlias>duckykey</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>duckyvpn2026</AndroidSigningKeyPass>
  </PropertyGroup>
</Project>
