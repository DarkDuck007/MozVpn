{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Launch (Moz_Avalonia Debug)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/Moz_Avalonia/bin/Debug/net10.0/Moz_Avalonia.dll",
            "args": [],
            "cwd": "${workspaceFolder}/Moz_Avalonia",
            "stopAtEntry": false,
            "console": "internalConsole",
            "env": {
                "DOTNET_ENVIRONMENT": "Development"
            }
        },
        {
            "name": ".NET Core Launch (Moz_Avalonia Release)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-release",
            "program": "${workspaceFolder}/Moz_Avalonia/bin/Release/net10.0/Moz_Avalonia.dll",
            "args": [],
            "cwd": "${workspaceFolder}/Moz_Avalonia",
            "stopAtEntry": false,
            "console": "internalConsole",
            "env": {
                "DOTNET_ENVIRONMENT": "Production"
            }
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ]
}

