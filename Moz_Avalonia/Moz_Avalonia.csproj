<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType Condition="'$(TargetFramework)' == 'net10.0'">WinExe</OutputType>
        <OutputType Condition="'$(TargetFramework)' == 'net10.0-android'">Library</OutputType>
        <TargetFrameworks Condition="'$(RuntimeIdentifier)' == 'linux-x64' or '$(RuntimeIdentifier)' == 'win-x64'">net10.0</TargetFrameworks>
        <TargetFrameworks Condition="'$(RuntimeIdentifier)' != 'linux-x64' and '$(RuntimeIdentifier)' != 'win-x64'">net10.0;net10.0-android</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ApplicationManifest Condition="'$(TargetFramework)' == 'net10.0'">app.manifest</ApplicationManifest>
        <ApplicationIcon Condition="'$(TargetFramework)' == 'net10.0'">Assets/avalonia-logo.ico</ApplicationIcon>
        <Version>1.0.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <Folder Include="Models\" />
        <AvaloniaResource Include="Assets\**" />
        <EmbeddedResource Include="..\MozVpnWPF\ServerList.txt" Link="Resources\ServerList.txt" />
        <EmbeddedResource Include="..\MozVpnWPF\StunList.txt" Link="Resources\StunList.txt" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.1" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.1" Condition="'$(TargetFramework)' == 'net10.0'" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="HotAvalonia" Version="3.1.4" />
        <PackageReference Include="DialogHost.Avalonia" Version="0.12.3" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MozUtil\MozUtil.csproj" />
    </ItemGroup>
    <Target Name="RemovePdbsFromPublish" AfterTargets="ComputeFilesToPublish">
        <ItemGroup>
            <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb' or '%(ResolvedFileToPublish.Extension)' == '.xml'" />
        </ItemGroup>
    </Target>
</Project>
