<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Moz_Avalonia.App"
             xmlns:local="using:Moz_Avalonia"
             xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             RequestedThemeVariant="Dark">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/tray-icon.png" ToolTipText="Moz VPN" Clicked="TrayIconClicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Show Window" Click="OpenMenuClicked" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Exit" Click="ExitMenuClicked" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>

    <Application.Styles>
        <FluentTheme />
        <dialogHost:DialogHostStyles />

        <!-- 4x Faster Dialog Animation (300ms -> 75ms) -->
        <Style Selector="dialogHost|DialogHost /template/ Border#PART_ContentCover">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.075" Easing="CircularEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="dialogHost|DialogHost /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.075" Easing="CircularEaseOut" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.075" Easing="CircularEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="#121F2C" />
            <Setter Property="BorderBrush" Value="#24384A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#8FA4B7" />
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#2962FF" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Foreground" Value="#FF8A8A" />
        </Style>
    </Application.Styles>
</Application>
