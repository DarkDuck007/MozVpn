<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Moz_Avalonia.ViewModels"
             xmlns:models="using:Moz_Avalonia.Models"
             xmlns:services="using:Moz_Avalonia.Services"
             xmlns:controls="using:Moz_Avalonia.Controls"
             xmlns:moz="using:MozUtil"
             x:Class="Moz_Avalonia.Views.DesktopMainView"
             x:Name="Root"
             x:DataType="vm:MainViewModel"
             Background="#09131D">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Background="#101D29" BorderBrush="#223548" BorderThickness="0,0,0,1" Padding="18,12">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Border Width="36" Height="36" CornerRadius="5" Background="#000000" ClipToBounds="True">
            <Image Source="/Assets/avalonia-logo.ico" Stretch="Uniform" />
          </Border>
          <StackPanel>
            <TextBlock Text="MOZ" FontWeight="Bold" FontSize="20" />
            <TextBlock Text="Classic Backend, Modern UI" Classes="muted" FontSize="11" />
          </StackPanel>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#B8CAD9" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <ComboBox Width="160" ItemsSource="{Binding Browsers}" VerticalAlignment="Stretch" SelectedItem="{Binding SelectedBrowser}" PlaceholderText="Browser" />
          <TextBox Width="230" Text="{Binding BrowserUrl}" VerticalAlignment="Stretch" PlaceholderText="URL for proxied browser" />
        </StackPanel>
      </Grid>
    </Border>

    <TabControl Grid.Row="1">
      <TabItem Header="Profiles">
        <Grid ColumnDefinitions="Auto,Auto,*">
          <Border Grid.Column="0" Width="{Binding ConnectionRailWidth}" Background="#0D1924"
                  BorderBrush="#223548" BorderThickness="0,0,1,0" Padding="10">
            <Grid RowDefinitions="Auto,*">
              <Button Content="{Binding EditorToggleText}" Command="{Binding ToggleEditorCommand}"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,10" />

              <ListBox Grid.Row="1" ItemsSource="{Binding Connections}" SelectedItem="{Binding SelectedConnection}" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ConnectionViewModel">
                    <Border Classes="card" Padding="6" Margin="0,0,0,2" HorizontalAlignment="Stretch">
                      <Grid>
                        <Grid IsVisible="{ReflectionBinding !DataContext.IsEditorOpen, ElementName=Root}"
                              RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                          <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse Width="9" Height="9" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                          </StackPanel>
                          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ServerAddress}" TextTrimming="CharacterEllipsis" FontSize="11" Classes="muted" />
                          <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,*,*,*" ColumnSpacing="8" Margin="0,8,0,0">
                            <StackPanel>
                              <TextBlock Text="Latency" Classes="muted" FontSize="9" />
                              <TextBlock Text="{Binding Latency}" Foreground="{Binding LatencyBrush}" FontWeight="SemiBold" FontSize="11" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                              <TextBlock Text="Connections" Classes="muted" FontSize="9" />
                              <TextBlock Text="{Binding ActiveConnections}" FontSize="11" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                              <TextBlock Text="Inbound" Classes="muted" FontSize="9" />
                              <TextBlock Text="{Binding InboundRate}" Foreground="#4CC9F0" FontSize="11" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                              <TextBlock Text="Outbound" Classes="muted" FontSize="9" />
                              <TextBlock Text="{Binding OutboundRate}" Foreground="#F72585" FontSize="11" />
                            </StackPanel>
                          </Grid>
                          <Grid Grid.Row="3" Grid.ColumnSpan="2" ColumnDefinitions="*,*,*,*" ColumnSpacing="5" Margin="0,8,0,0">
                            <Button Content="Start" Command="{Binding ConnectCommand}" Padding="4" FontSize="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                            <Button Grid.Column="1" Content="Stop" Command="{Binding DisconnectCommand}" Padding="4" FontSize="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                            <Button Grid.Column="2" Content="Edit" Command="{ReflectionBinding DataContext.EditConnectionCommand, ElementName=Root}" CommandParameter="{Binding}" Padding="4" FontSize="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                            <Button Grid.Column="3" Content="Delete" Classes="danger" Command="{ReflectionBinding DataContext.RemoveConnectionCommand, ElementName=Root}" CommandParameter="{Binding}" Padding="4" FontSize="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                          </Grid>
                        </Grid>

                        <Grid IsVisible="{ReflectionBinding DataContext.IsEditorOpen, ElementName=Root}"
                              RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" MinHeight="62">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding Latency}" Foreground="{Binding LatencyBrush}" FontWeight="SemiBold" FontSize="10" />
                          <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="13,8,0,0">
                            <TextBlock Text="{Binding InboundRate, StringFormat=↓ {0}}" Classes="muted" FontSize="10" />
                            <TextBlock Text="{Binding OutboundRate, StringFormat=↑ {0}}" Classes="muted" FontSize="10" />
                          </StackPanel>
                        </Grid>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <Border Grid.Column="1" Width="330" IsVisible="{Binding IsEditorOpen}" Background="#101D29"
                  BorderBrush="#223548" BorderThickness="0,0,1,0" Padding="14">
            <Grid RowDefinitions="Auto,*">
              <TextBlock Text="{Binding EditorHeader}" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,10" />
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8" Margin="0,0,5,8">
                  <TextBlock Text="Profile name" Classes="muted" />
                  <TextBox Text="{Binding ProfileName}" />
                  <TextBlock Text="Moz server" Classes="muted" />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Text="{Binding ServerAddress, Mode=TwoWay}" PlaceholderText="https://server/" />
                    <Button Grid.Column="1" Content="＋" Command="{Binding AddCustomServerCommand}" ToolTip.Tip="Remember this server" />
                  </Grid>
                  <ComboBox ItemsSource="{Binding ServerOptions}" SelectedItem="{Binding SelectedServerOption, Mode=TwoWay}" PlaceholderText="Known servers" />
                  <TextBlock Text="STUN server" Classes="muted" />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Text="{Binding StunServer, Mode=TwoWay}" PlaceholderText="Auto or host:port" />
                    <Button Grid.Column="1" Content="＋" Command="{Binding AddCustomStunCommand}" ToolTip.Tip="Remember this STUN server" />
                  </Grid>
                  <ComboBox ItemsSource="{Binding StunOptions}" SelectedItem="{Binding SelectedStunOption, Mode=TwoWay}" PlaceholderText="Known STUN servers" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <StackPanel>
                      <TextBlock Text="Transport" Classes="muted" />
                      <ComboBox ItemsSource="{Binding TransportOptions}" SelectedItem="{Binding SelectedTransport}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="Max channels" Classes="muted" />
                      <ComboBox ItemsSource="{Binding ChannelOptions}" SelectedItem="{Binding MaxChannels}" />
                    </StackPanel>
                  </Grid>
                  <CheckBox Content="Use HTTP proxy to initiate connection" IsChecked="{Binding UseHttpProxy}" />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Text="{Binding HttpProxy}" PlaceholderText="http://proxy:port" />
                    <Button Grid.Column="1" Content="＋" Command="{Binding AddCustomHttpProxyCommand}" ToolTip.Tip="Remember this HTTP proxy" />
                  </Grid>
                  <ComboBox ItemsSource="{Binding HttpProxyOptions}" SelectedItem="{Binding SelectedHttpProxyOption}" PlaceholderText="Saved HTTP proxies" />
                  <WrapPanel>
                    <CheckBox Content="Force symmetric" IsChecked="{Binding ForceSymmetric}" Margin="0,0,12,0" />
                    <CheckBox Content="Aggressive ports" IsChecked="{Binding AggressivePortScan}" Margin="0,0,12,0" />
                    <CheckBox Content="Skip STUN" IsChecked="{Binding SkipStun}" />
                  </WrapPanel>
                  <CheckBox Content="Start this profile at launch" IsChecked="{Binding AutoConnectProfile}" />
                  <Grid ColumnDefinitions="Auto,*,*" ColumnSpacing="8">
                    <Button Content="Cancel" Command="{Binding CancelEditCommand}" IsVisible="{Binding IsEditing}" />
                    <Button Grid.Column="1" Content="{Binding SaveButtonText}" Command="{Binding AddConnectionCommand}" />
                    <Button Grid.Column="2" Content="{Binding SaveAndConnectButtonText}" Classes="accent" Command="{Binding AddAndConnectCommand}" />
                  </Grid>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Border>

          <ScrollViewer Grid.Column="2">
            <ContentControl Content="{Binding SelectedConnection}" Margin="18">
              <ContentControl.DataTemplates>
                <DataTemplate DataType="vm:ConnectionViewModel" x:DataType="vm:ConnectionViewModel">
                  <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" Classes="heading" />
                        <TextBlock Text="{Binding ServerAddress}" Classes="muted" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="Edit" Command="{ReflectionBinding DataContext.EditConnectionCommand, ElementName=Root}" CommandParameter="{Binding}" />
                        <Button Content="Remove" Classes="danger" Command="{ReflectionBinding DataContext.RemoveConnectionCommand, ElementName=Root}" CommandParameter="{Binding}" />
                        <Button Content="Copy proxies" Command="{ReflectionBinding DataContext.CopyProxyCommand, ElementName=Root}" CommandParameter="{Binding}" />
                        <Button IsVisible="{ReflectionBinding DataContext.IsWindows, ElementName=Root}"
                                Content="System proxy"
                                Command="{ReflectionBinding DataContext.UseAsSystemProxyCommand, ElementName=Root}"
                                CommandParameter="{Binding}" />
                        <Button Content="Launch browser" Classes="accent" Command="{ReflectionBinding DataContext.LaunchBrowserCommand, ElementName=Root}" CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                      <Border Classes="card">
                        <StackPanel>
                          <TextBlock Text="UDP tunnel" Classes="muted" />
                          <TextBlock Text="{Binding UdpStatus}" Foreground="{Binding StatusBrush}" FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="1" Classes="card">
                        <StackPanel><TextBlock Text="HTTP channel" Classes="muted" /><TextBlock Text="{Binding HttpStatus}" FontSize="18" FontWeight="SemiBold" /></StackPanel>
                      </Border>
                      <Border Grid.Column="2" Classes="card">
                        <StackPanel><TextBlock Text="Uptime" Classes="muted" /><TextBlock Text="{Binding Uptime}" FontSize="18" FontWeight="SemiBold" /></StackPanel>
                      </Border>
                    </Grid>

                    <Grid ColumnDefinitions="2*,*" ColumnSpacing="12">
                      <Border Classes="card">
                        <StackPanel Spacing="8">
                          <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Text="Bandwidth · last 90 seconds" FontWeight="SemiBold" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="0,0,14,0"><Ellipse Fill="#4CC9F0" Width="8" Height="8" /><TextBlock Text="Inbound" Classes="muted" /></StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5"><Ellipse Fill="#F72585" Width="8" Height="8" /><TextBlock Text="Outbound" Classes="muted" /></StackPanel>
                          </Grid>
                          <controls:BandwidthGraph Height="190" Connection="{Binding}" />
                          <Grid ColumnDefinitions="*,*,*,*">
                            <StackPanel><TextBlock Text="Down" Classes="muted" /><TextBlock Text="{Binding InboundRate}" /></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="Up" Classes="muted" /><TextBlock Text="{Binding OutboundRate}" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Total down" Classes="muted" /><TextBlock Text="{Binding TotalIn}" /></StackPanel>
                            <StackPanel Grid.Column="3"><TextBlock Text="Total up" Classes="muted" /><TextBlock Text="{Binding TotalOut}" /></StackPanel>
                          </Grid>
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="1" Classes="card">
                        <Grid RowDefinitions="Auto,*,Auto">
                          <TextBlock Text="Local proxies" FontWeight="SemiBold" />
                          <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="10">
                            <StackPanel><TextBlock Text="SOCKS5" Classes="muted" /><SelectableTextBlock Text="{Binding SocksAddress}" /></StackPanel>
                            <StackPanel><TextBlock Text="HTTP" Classes="muted" /><SelectableTextBlock Text="{Binding HttpAddress}" /></StackPanel>
                          </StackPanel>
                          <TextBlock Grid.Row="2" Text="Each connection has unique local ports." Classes="muted" FontSize="11" />
                        </Grid>
                      </Border>
                    </Grid>

                    <TabControl MinHeight="200">
                      <TabItem Header="Client">
                        <Border Classes="card" Margin="0,8,0,0">
                          <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" RowSpacing="14">
                            <StackPanel><TextBlock Text="Latency" Classes="muted" /><TextBlock Text="{Binding Latency}" Foreground="{Binding LatencyBrush}" FontSize="22" /></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="Packet loss" Classes="muted" /><TextBlock Text="{Binding PacketLoss}" FontSize="22" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Transport" Classes="muted" /><TextBlock Text="{Binding Transport}" FontSize="22" /></StackPanel>
                            <StackPanel Grid.Row="1"><TextBlock Text="Connections" Classes="muted" /><TextBlock Text="{Binding ActiveConnections}" FontSize="22" /></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="Channels" Classes="muted" /><TextBlock Text="{Binding Channels}" FontSize="22" /></StackPanel>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ErrorMessage}" Foreground="IndianRed" TextWrapping="Wrap" />
                          </Grid>
                        </Border>
                      </TabItem>
                      <TabItem Header="Server stats">
                        <Grid Margin="0,8,0,0" RowDefinitions="Auto,*">
                          <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Toggle streaming" Command="{Binding ToggleServerStatsCommand}" /><TextBlock Text="{Binding ServerStatsStatus}" VerticalAlignment="Center" /></StackPanel>
                          <ScrollViewer Grid.Row="1" Margin="0,8,0,0">
                            <ItemsControl ItemsSource="{Binding ServerStats}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:StatItem">
                                  <Grid ColumnDefinitions="2*,*,110" ColumnSpacing="10" Margin="4,3">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" VerticalAlignment="Center" />
                                    <controls:StatSparkline Grid.Column="2" Height="28" Stat="{Binding}" />
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </ScrollViewer>
                        </Grid>
                      </TabItem>
                      <TabItem Header="UDP relays">
                        <Grid Margin="0,8,0,0" RowDefinitions="Auto,*">
                          <Grid ColumnDefinitions="*,140,Auto" ColumnSpacing="8">
                            <TextBox Text="{Binding RelayEndpoint}" PlaceholderText="destination host:port" />
                            <TextBox Grid.Column="1" Text="{Binding RelayListenPort}" PlaceholderText="local port" />
                            <Button Grid.Column="2" Content="Create relay" Command="{Binding CreateRelayCommand}" />
                          </Grid>
                          <ItemsControl Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding Relays}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="moz:SubTunInfo">
                                <Border Classes="card" Padding="10" Margin="0,0,0,6">
                                  <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                                    <TextBlock Text="{Binding ID}" />
                                    <TextBlock Grid.Column="1" Text="{Binding DestinationHostName}" />
                                    <TextBlock Grid.Column="2" Text=":" />
                                    <TextBlock Grid.Column="3" Text="{Binding DestinationPort}" />
                                    <TextBlock Grid.Column="4" Text="{Binding LocalEndpoint}" />
                                    <TextBlock Grid.Column="5" Text="{Binding Status}" />
                                    <Button Grid.Column="6" Content="Retry" Command="{ReflectionBinding $parent[ItemsControl].DataContext.ReconnectRelayCommand}" CommandParameter="{Binding}" />
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Grid>
                      </TabItem>
                      <TabItem Header="Log">
                        <TextBox Margin="0,8,0,0" Text="{Binding Log}" AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap" FontFamily="monospace" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                      </TabItem>
                    </TabControl>
                  </StackPanel>
                </DataTemplate>
              </ContentControl.DataTemplates>
            </ContentControl>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <TabItem Header="STUN tests">
        <Grid Margin="18" RowDefinitions="Auto,Auto,*" RowSpacing="12">
          <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="8">
            <Button Content="Start" Command="{Binding StartStunTestsCommand}" MinWidth="76" />
            <Button Grid.Column="1" Content="Stop" Command="{Binding StopStunTestsCommand}" MinWidth="76" />
            <Button Grid.Column="2" Content="Restart" Command="{Binding RestartStunTestsCommand}" MinWidth="76" />
            <TextBlock Grid.Column="3" Text="Batch size" Classes="muted" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBox Grid.Column="4" Width="62" Text="{Binding StunTestBatchSize}" HorizontalContentAlignment="Right" />
            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <TextBlock Text="Timeout" Classes="muted" VerticalAlignment="Center" />
              <TextBox Width="82" Text="{Binding StunTestTimeoutMs}" HorizontalContentAlignment="Right" />
              <TextBlock Text="ms" Classes="muted" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>

          <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding StunTestSummary}" />
            <TextBlock Grid.Column="1" Text="All configured servers are included; batch size controls concurrency." Classes="muted" FontSize="11" />
          </Grid>

          <Border Grid.Row="2" Classes="card" Padding="10">
            <Grid RowDefinitions="Auto,*">
              <Grid ColumnDefinitions="2*,130,100,100,3*" ColumnSpacing="12" Margin="6,2,6,8">
                <TextBlock Text="Server" Classes="muted" />
                <TextBlock Grid.Column="1" Text="Status" Classes="muted" />
                <TextBlock Grid.Column="2" Text="Latency" Classes="muted" />
                <TextBlock Grid.Column="3" Text="Timeout" Classes="muted" />
                <TextBlock Grid.Column="4" Text="Result" Classes="muted" />
              </Grid>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding StunResults}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="services:StunProbeResult">
                      <Grid ColumnDefinitions="2*,130,100,100,3*" ColumnSpacing="12" Margin="6,5">
                        <TextBlock Text="{Binding Server}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding Status}" />
                        <TextBlock Grid.Column="2" Text="{Binding LatencyMs, StringFormat={}{0} ms}" />
                        <TextBlock Grid.Column="3" Text="{Binding TimeoutMs, StringFormat={}{0} ms}" Classes="muted" />
                        <TextBlock Grid.Column="4" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Detail}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Background="#101D29" BorderBrush="#223548" BorderThickness="0,1,0,0" Padding="12,7">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="Multiple active tunnels are supported; switch the system proxy or launch isolated browser profiles at any time." Classes="muted" FontSize="11" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <TextBlock Text="Settings: " Classes="muted" FontSize="11" />
          <TextBlock Text="{Binding SettingsPath}" Classes="muted" FontSize="11" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
