<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Moz_Avalonia.ViewModels"
        xmlns:views="using:Moz_Avalonia.Views"
        x:Class="Moz_Avalonia.Views.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Moz VPN"
        Width="1220" Height="820" MinWidth="360" MinHeight="500"
        Background="#09131D">
  <views:MainContainerView DataContext="{Binding}" />
</Window>
